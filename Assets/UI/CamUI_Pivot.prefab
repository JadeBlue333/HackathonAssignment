--- !u!114 &7156701763335501604
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1569313160397056493}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 20c41dc69823e49a89101b76fb14c262, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiscardWarningNotice
  noticeObject: {fileID: 4709636423644098178}
  noticeText: {fileID: 2353371189331372883}
  delayBeforeShow: 3
  holdDuration: 4
  fadeOutDuration: 1
  useBootEffect: 1
  bootStartDelay: 0.05
  warningMessagesKR:
  - "[SYSTEM] \uD3D0\uAE30 \uB300\uC0C1 \uBAA8\uD130\uC758 \uC624\uBD84\uB958\uAC00
    \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uD3D0\uAE30\uD558\uC9C0 \uC54A\uC740
    \uBAA8\uD130\uB294 \uD3ED\uBC1C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4."
  - "[AUTO] \uD3ED\uBC1C \uC704\uD5D8\uC774 \uC788\uB294 \uBAA8\uD130\uB294 \uC815\uC0C1
    \uCC98\uB9AC\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uD574\uB2F9 \uBAA8\uD130\uB294
    \uBC18\uB4DC\uC2DC \uD3D0\uAE30\uD558\uC2ED\uC2DC\uC624."
  - "\uB610 \uD130\uB728\uB838\uB098?\n\uD3D0\uAE30\uD558\uB77C\uB294 \uC9C0\uCE68\uC774
    \uC7A5\uC2DD\uC73C\uB85C \uBCF4\uC774\uB098?"
  - "[SYSTEM] \uD3D0\uAE30 \uB300\uC0C1 \uBAA8\uD130\uC758 \uBBF8\uCC98\uB9AC\uAC00
    \uBC18\uBCF5\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uD3ED\uBC1C \uC0AC\uACE0
    \uBC29\uC9C0\uB97C \uC704\uD574 \uD3D0\uAE30 \uAE30\uC900\uC744 \uC7AC\uD655\uC778\uD558\uC2ED\uC2DC\uC624."
  - "[AUTO] \uACBD\uACE0.\n\uD3D0\uAE30 \uB300\uC0C1 \uBAA8\uD130\uB97C \uC815\uC0C1
    \uCC98\uB9AC\uD560 \uACBD\uC6B0 \uD3ED\uBC1C \uC704\uD5D8\uC774 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD558\u2026 \uB208\uC740 \uB2EC\uB824 \uC788\uB098?\n\uD3D0\uAE30\uD574\uC57C
    \uD558\uB294 \uBAA8\uD130\uC796\uC544!!!!"
  - "[SYSTEM] \uB3D9\uC77C\uD55C \uD3D0\uAE30 \uC624\uB958\uAC00 \uBC18\uBCF5\uB418\uACE0
    \uC788\uC2B5\uB2C8\uB2E4.\n\uC791\uC5C5 \uC815\uD655\uB3C4 \uC800\uD558\uAC00
    \uAE30\uB85D\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC544\uC9C1\uB3C4 \uAE30\uC900\uC744 \uBAA8\uB974\uACA0\uB098?\n\uD130\uB728\uB9AC\uC9C0
    \uB9D0\uACE0 \uD3D0\uAE30\uD558\uB77C\uACE0. \uC5B4\uB824\uC6B4\uAC00?"
  - "[AUTO] \uBC18\uBCF5 \uACBD\uACE0.\n\uD3D0\uAE30 \uB300\uC0C1 \uBAA8\uD130\uB294
    \uC815\uC0C1 \uB4F1\uAE09\uC73C\uB85C \uBD84\uB958\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uC774\uCBE4 \uB418\uBA74 \uC2E4\uC218\uAC00 \uC544\uB2C8\uB77C \uACE0\uC9D1\uC774\uAD70.\n\uD3D0\uAE30\uD560
    \uAC74 \uD3D0\uAE30\uD574."
  - "[SYSTEM] \uD3ED\uBC1C \uC0AC\uACE0 \uB204\uC801.\n\uD3D0\uAE30 \uB300\uC0C1
    \uBAA8\uD130\uC758 \uC624\uBD84\uB958\uAC00 \uC9C0\uC18D\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uB0B4\uAC00 \uD3D0\uAE30 \uAE30\uC900\uAE4C\uC9C0 \uB300\uC2E0 \uBD10\uC918\uC57C
    \uD558\uB098?\n\uB2E4\uC74C \uAC83\uB3C4 \uD130\uB728\uB9AC\uBA74 \uD55C\uBC88
    \uC0DD\uAC01\uD574 \uBCF4\uC9C0."
  - "[AUTO] \uACBD\uACE0.\n\uD3D0\uAE30 \uB300\uC0C1 \uBAA8\uD130\uC758 \uC815\uC0C1
    \uCC98\uB9AC\uB97C \uC989\uC2DC \uC911\uB2E8\uD558\uC2ED\uC2DC\uC624."
  - "\uBA87 \uBC88\uC744 \uB9D0\uD574\uC57C \uC54C\uC544\uB4E3\uC9C0?\n\uD130\uC9C0\uAE30
    \uC804\uC5D0. \uD3D0\uAE30. \uD574."
  - "[SYSTEM] \uD3D0\uAE30 \uC624\uB958\uAC00 \uC9C0\uC18D\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4.\n\uC791\uC5C5\uC790
    \uAC80\uC218 \uB2A5\uB825 \uC800\uD558\uAC00 \uC758\uC2EC\uB429\uB2C8\uB2E4."
  - "\uD3ED\uBC1C\uC74C\uC73C\uB85C \uC5F0\uC8FC\uB77C\uB3C4 \uD558\uB098?\n\uADF8\uB9CC\uD558\uB3C4\uB85D."
  - "[AUTO] \uBC18\uBCF5 \uACBD\uACE0.\n\uD3ED\uBC1C \uC704\uD5D8 \uC81C\uD488\uC740
    \uBC18\uB4DC\uC2DC \uD3D0\uAE30\uD558\uC2ED\uC2DC\uC624."
  - "[SYSTEM] \uD3D0\uAE30 \uC624\uB958 \uB204\uC801.\n\uC791\uC5C5\uC790\uC758 \uC9C0\uC18D\uC801\uC778
    \uC624\uBD84\uB958\uAC00 \uAE30\uB85D\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uB610 \uD130\uB728\uB838\uAD70.\n\uB2E4\uC74C \uD3D0\uAE30 \uB300\uC0C1\uC740
    \uB124\uAC00 \uB418\uC9C0 \uC54A\uAC8C \uC798\uD574."
  - "\uB610\uAD70.\n\uC774\uC81C \uB180\uB78D\uC9C0\uB3C4 \uC54A\uB2E4."
  - "\uB610 \uD130\uB728\uB838\uB098?\n\uB300\uB2E8\uD558\uAD70. \uC548 \uC88B\uC740
    \uC758\uBBF8\uB85C."
  - "\uBA87 \uBC88\uC9F8\uC9C0?\n\uC544\uB2C8\uB2E4. \uC138\uB294 \uAC83\uB3C4 \uAD00\uB450\uC9C0."
  - "\uD3D0\uAE30.\n\uB450 \uAE00\uC790\uAC00 \uADF8\uB807\uAC8C \uC5B4\uB835\uB098?"
  - "\uB610 \uD3ED\uBC1C\uC774\uAD70.\n\uC77C\uAD00\uC131 \uD558\uB098\uB294 \uC778\uC815\uD558\uC9C0."
  - "\uC77C\uBD80\uB7EC \uC774\uB7EC\uB294 \uAC74\uAC00?"
  - "\uC774\uCBE4 \uB418\uBA74 \uC2E4\uC218\uB77C\uACE0 \uD558\uAE30\uB3C4 \uC5B4\uB835\uAD70."
  - "\uD3ED\uBC1C\uC2DC\uD0A4\uB294 \uAC8C \uC5C5\uBB34\uC778 \uC904 \uC544\uB098?"
  - "\uADF8 \uD310\uB2E8\uB825\uC73C\uB85C \uC9C0\uAE08\uAE4C\uC9C0 \uC5B4\uB5BB\uAC8C
    \uBC84\uD2F4 \uAC70\uC9C0?"
  - "\uD3ED\uBC1C\uC74C \uB4E4\uB9AC\uC9C0?\n\uADF8\uAC8C \uB124 \uAC80\uC218 \uACB0\uACFC\uB2E4."
  - "\uBAA8\uD130\uBCF4\uB2E4 \uB124 \uD310\uB2E8\uC774 \uB354 \uBD88\uC548\uC815\uD558\uAD70."
  - "[SYSTEM] \uD3D0\uAE30 \uB300\uC0C1 \uC624\uBD84\uB958 \uBC18\uBCF5.\n\uCD94\uAC00
    \uACBD\uACE0\uC758 \uC2E4\uD6A8\uC131\uC774 \uC758\uC2EC\uB429\uB2C8\uB2E4."
  - "[SYSTEM] \uD3ED\uBC1C \uC0AC\uACE0 \uAC10\uC9C0.\n\u2026\uB610 \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4."
  - "[SYSTEM] \uACBD\uACE0 \uD69F\uC218 \uCD08\uACFC.\n\uCD94\uAC00 \uC124\uBA85\uC744
    \uC0DD\uB7B5\uD569\uB2C8\uB2E4."
  warningMessagesEN:
  - '[SYSTEM] Misclassification of a discard motor detected.

    Failure to discard
    it may result in an explosion.'
  - '[AUTO] Motors at risk of explosion cannot be processed as normal.

    They
    must be discarded.'
  - 'Blew up another one?

    Do the discard instructions look decorative to you?'
  - '[SYSTEM] Discard motors are repeatedly being left unprocessed.

    Review the
    discard criteria to prevent further explosions.'
  - '[AUTO] Warning.

    Processing a discard motor as normal may result in an explosion.'
  - 'Do you even have eyes?

    THAT MOTOR IS SUPPOSED TO BE DISCARDED!!!!'
  - '[SYSTEM] Repeated discard errors detected.

    A decline in work accuracy has
    been recorded.'
  - "Still don\u2019t know the criteria?\nDiscard it instead of blowing it up. Is
    that difficult?"
  - '[AUTO] Repeated warning.

    Discard motors cannot be assigned a normal grade.'
  - "At this point, it\u2019s not a mistake. It\u2019s stubbornness.\nDiscard what
    needs to be discarded."
  - '[SYSTEM] Explosion incidents accumulating.

    Misclassification of discard
    motors is continuing.'
  - "Do I need to check the discard criteria for you too?\nBlow up another one and
    we\u2019ll have a problem."
  - '[AUTO] Warning.

    Immediately stop processing discard motors as normal.'
  - 'How many times do I have to say it?

    Before it explodes. Discard. It.'
  - '[SYSTEM] Discard errors persist.

    Operator inspection performance is now
    in question.'
  - 'Are you composing music with explosions?

    Stop.'
  - '[AUTO] Repeated warning.

    Products posing an explosion risk must be discarded.'
  - '[SYSTEM] Discard errors accumulating.

    Persistent operator misclassification
    has been recorded.'
  - "Another one exploded.\nDo your job before you\u2019re the next thing we discard."
  - "Again.\nI\u2019m not even surprised anymore."
  - 'Another one?

    Impressive. Not in a good way.'
  - "How many is that now?\nNever mind. I\u2019ve stopped counting."
  - 'Discard.

    Is that really so hard to understand?'
  - "Another explosion.\nAt least you\u2019re consistent."
  - Are you doing this on purpose?
  - At this point, calling it a mistake is generous.
  - Do you think blowing them up is your job?
  - How have you lasted this long with judgment like that?
  - "Hear that explosion?\nThat\u2019s your inspection result."
  - Your judgment is less stable than the motor.
  - '[SYSTEM] Repeated misclassification of discard items.

    Further warnings
    may be ineffective.'
  - "[SYSTEM] Explosion detected.\n\u2026Again."
  - '[SYSTEM] Warning count exceeded.

    Further explanation omitted.'
  audioSource: {fileID: 1994718056113339114}
  noticeSound: {fileID: 8300000, guid: 7c2df0dedd5254755bfee0d230b6e7e4, type: 3}
  noticeVolume: 0.9
