  m_Script: {fileID: 11500000, guid: 20c41dc69823e49a89101b76fb14c262, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DiscardWarningNotice
  noticeObject: {fileID: 4709636423644098178}
  noticeText: {fileID: 2353371189331372883}
  delayBeforeShow: 3
  holdDuration: 4
  fadeOutDuration: 1
  useBootEffect: 1
  bootStartDelay: 0.05
  warningMessages:
  - "[SYSTEM] \uD3D0\uAE30 \uB300\uC0C1 \uC81C\uD488\uC758 \uC624\uBD84\uB958\uAC00
    \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uD3D0\uAE30 \uAE30\uC900\uC744
    \uB2E4\uC2DC \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
  - "[AUTO] \uD3D0\uAE30 \uB300\uC0C1 \uC81C\uD488\uC740 \uC815\uC0C1 \uCC98\uB9AC\uD560
    \uC218 \uC5C6\uC2B5\uB2C8\uB2E4.\n\uD574\uB2F9 \uC81C\uD488\uC740 \uBC18\uB4DC\uC2DC
    \uD3D0\uAE30\uD558\uC2ED\uC2DC\uC624."
  - "\uB610 \uD130\uB728\uB838\uB098? \uD3D0\uAE30\uB77C\uACE0 \uC801\uD78C \uAC74
    \uADF8\uB0E5 \uD3D0\uAE30\uD558\uBA74 \uB41C\uB2E4."
  - "[SYSTEM] \uB3D9\uC77C\uD55C \uCC98\uB9AC \uC624\uB958\uAC00 \uBC18\uBCF5\uB418\uACE0
    \uC788\uC2B5\uB2C8\uB2E4.\n\uAC80\uC218 \uAE30\uC900\uC744 \uC7AC\uD655\uC778\uD558\uC2ED\uC2DC\uC624."
  - "\uD558... \uC9D1\uC911\uD574"
  - "[AUTO] \uACBD\uACE0.\n\uD3D0\uAE30 \uB300\uC0C1 \uC81C\uD488\uC758 \uBBF8\uCC98\uB9AC\uB85C
    \uC778\uD55C \uC0AC\uACE0\uAC00 \uBC18\uBCF5\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC124\uB9C8 \uC544\uC9C1\uB3C4 \uAE30\uC900\uC744 \uD5F7\uAC08\uB9AC\uB294
    \uAC74 \uC544\uB2C8\uACA0\uC9C0. \uB2E4\uC74C\uBD80\uD130\uB294 \uC81C\uB300\uB85C
    \uCC98\uB9AC\uD574."
  - "[SYSTEM] \uD3D0\uAE30 \uC624\uB958 \uB204\uC801. \uC791\uC5C5 \uC815\uD655\uB3C4
    \uC800\uD558\uAC00 \uAE30\uB85D\uB418\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD3D0\uAE30 \uB300\uC0C1 \uC81C\uD488\uC758 \uC624\uBD84\uB958\uAC00 \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uD3D0\uAE30
    \uAE30\uC900\uC744 \uCDA9\uC871\uD55C \uC81C\uD488\uC740\n\uBC18\uB4DC\uC2DC
    \uD3D0\uAE30 \uCC98\uB9AC\uD558\uC2ED\uC2DC\uC624."
  - "\uC774 \uC815\uB3C4\uBA74 \uC2E4\uC218\uAC00 \uC544\uB2C8\uB77C \uC2B5\uAD00
    \uC544\uB2CC\uAC00? \uD3D0\uAE30\uD560 \uAC74 \uD3D0\uAE30\uD574."
  - "[AUTO] \uBC18\uBCF5 \uACBD\uACE0. \uD3D0\uAE30 \uB300\uC0C1 \uC81C\uD488\uC740
    \uC815\uC0C1 \uB4F1\uAE09\uC73C\uB85C \uBD84\uB958\uD560 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
  - "\uB354 \uC124\uBA85\uD560 \uD544\uC694 \uC5C6\uACA0\uC9C0. \uD130\uC9C0\uAE30
    \uC804\uC5D0 \uD3D0\uAE30\uD574."
  - "\uD3ED\uBC1C\uC18C\uB9AC\uB85C \uC5F0\uC8FC\uD558\uB098?\n\uADF8\uB9CC\uD558\uB3C4\uB85D."
  - "[SYSTEM] \uD3D0\uAE30 \uB300\uC0C1 \uC81C\uD488\uC758 \uC624\uBD84\uB958\uAC00
    \uAC10\uC9C0\uB418\uC5C8\uC2B5\uB2C8\uB2E4.\n\uD3D0\uAE30 \uAE30\uC900\uC744
    \uB2E4\uC2DC \uD655\uC778\uD558\uC2ED\uC2DC\uC624."
  audioSource: {fileID: 1994718056113339114}
  noticeSound: {fileID: 8300000, guid: 7c2df0dedd5254755bfee0d230b6e7e4, type: 3}
  noticeVolume: 0.9
