  m_Script: {fileID: 11500000, guid: 0142cec793cef3a4e8693b5de1d05e8c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FortuneController
  fortunePanel: {fileID: 1823777724762134809}
  fortuneText: {fileID: 8923701368134417334}
  fortunes:
  - fortuneText: "\uC624\uB298\uC740 \uC544\uC774\uC2A4\uD06C\uB9BC\uC774 \uB179\uAE30
      \uC804\uC5D0 \uD589\uC6B4\uC774 \uBA3C\uC800 \uCC3E\uC544\uC624\uACA0\uAD70\uC694!\n<\uAC00\uC9C4
      \uB3C8\uC774 2\uBC30\uAC00 \uB418\uC5C8\uC2B5\uB2C8\uB2E4.>"
  - fortuneText: "\uC624\uB298\uC740 \uD55C \uC2A4\uCFF1 \uB354 \uC5B9\uC5B4\uB3C4
      \uB420 \uB9CC\uD07C \uC6B4\uC774 \uC88B\uC2B5\uB2C8\uB2E4.\n<\uAC00\uC9C4 \uB3C8\uC5D0
      \uBCC0\uD654\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.>"
  - fortuneText: "\uB2EC\uCF64\uD55C \uC77C\uC774 \uD558\uB098\uCBE4\uC740 \uC0DD\uAE38
      \uAC83 \uAC19\uC2B5\uB2C8\uB2E4."
  - fortuneText: "\uBB34\uB09C\uD558\uAC8C \uC88B\uC740 \uB0A0\uC785\uB2C8\uB2E4.\n\uC544\uC774\uC2A4\uD06C\uB9BC
      \uD558\uB098 \uC815\uB3C4\uC758 \uD589\uC6B4\uC740 \uAE30\uB300\uD574\uB3C4
      \uB418\uACA0\uB124\uC694.\n<\uAC00\uC9C4 \uB3C8\uC5D0 \uBCC0\uD654\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.>"
  - fortuneText: "\uC624\uB298\uC740 \uD3C9\uBC94\uD55C \uBC14\uB2D0\uB77C \uAC19\uC740
      \uD558\uB8E8\uC785\uB2C8\uB2E4. \uB098\uC058\uC9C4 \uC54A\uC8E0.\n<\uAC00\uC9C4
      \uB3C8\uC5D0 \uBCC0\uD654\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.>"
  - fortuneText: "\uC544\uC774\uC2A4\uD06C\uB9BC\uC744 \uB5A8\uC5B4\uB728\uB9AC\uC9C0
      \uC54A\uAC8C \uC870\uC2EC\uD558\uC138\uC694.\n\uC791\uC740 \uC2E4\uC218\uAC00
      \uC0DD\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n<\uAC00\uC9C4 \uB3C8\uC5D0 \uBCC0\uD654\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4.>"
  - fortuneText: "\uC624\uB298\uC740 \uC544\uC774\uC2A4\uD06C\uB9BC\uC774 \uC870\uAE08
      \uBE68\uB9AC \uB179\uACA0\uAD70\uC694.\n\uC190\uD574\uB97C \uC870\uC2EC\uD558\uC138\uC694.\n<\uAC00\uC9C4
      \uB3C8\uC5D0 \uBCC0\uD654\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.>"
  - fortuneText: "\uCF58\uC740 \uBD80\uC11C\uC9C0\uACE0 \uC544\uC774\uC2A4\uD06C\uB9BC\uC740
      \uB179\uB294 \uB0A0\uC785\uB2C8\uB2E4.\n\uBB34\uB9AC\uD558\uC9C0 \uC54A\uB294
      \uAC8C \uC88B\uACA0\uB124\uC694.\n<\uAC00\uC9C4 \uB3C8\uC5D0 \uBCC0\uD654\uAC00
      \uC5C6\uC2B5\uB2C8\uB2E4.>"
  - fortuneText: "\uC624\uB298\uC740 \uBE48 \uCF58\uB9CC \uB0A8\uC744\uC9C0\uB3C4
      \uBAA8\uB974\uACA0\uC2B5\uB2C8\uB2E4.\n\uAC00\uC9C4 \uAC78 \uC798 \uCC59\uAE30\uC138\uC694.\n<\uAC00\uC9C4
      \uB3C8\uC5D0 \uBCC0\uD654\uAC00 \uC5C6\uC2B5\uB2C8\uB2E4.>"
  - fortuneText: "\uC544\uC774\uC2A4\uD06C\uB9BC\uB3C4 \uC6B4\uB3C4 \uB2E4 \uB179\uC544\uBC84\uB838\uAD70\uC694.\n<\uCD5C\uC545\uC758
      \uC6B4\uC138! \uAC00\uC9C4 \uB3C8\uC744 \uC804\uBD80 \uBAB0\uC218\uB2F9\uD588\uC2B5\uB2C8\uB2E4.>"
