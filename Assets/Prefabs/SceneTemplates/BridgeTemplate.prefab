--- !u!114 &4521109688250147309
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 681502840425783155}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 386db9909b7e3164c8f6dbf9d2e8bf2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroManager
  blackImage: {fileID: 2950281403524514494}
  introText: {fileID: 3992562194887093569}
  introTexts:
  - "\uD50C\uB8E8\uD1A0\uC2A4 \uACF5\uC5C5\uC758 \uD6CC\uB96D\uD55C \uC77C\uAFBC,
    \uC218\uB9CE\uC740 AT0805 \uC911 \uD558\uB098."
  - "\uC5F0\uBE44\uB294 \uB5A8\uC5B4\uC9C0\uC9C0\uB9CC \uC77C\uC740 \uC798\uD55C\uB2F5\uB2C8\uB2E4!"
  - "... \uC554\uC694, \uC774\uACF3\uC5D0\uC11C \uB098\uB294 \uC8FD\uC5B4\uB77C \uC77C\uB9CC
    \uD574\uC694."
  - "\uB2F9\uC2E0\uC5D0\uAC8C\uB9CC \uB9D0\uD574\uC904\uAC8C\uC694. \uC5EC\uAE30
    \uC0AC\uC7A5\uC740 \uC815\uB9D0 \uC545\uB3C5\uD574\uC694."
  - "\uC6B0\uB9AC\uAC19\uC740 \uB85C\uBD07\uC744 \uC5F0\uB8CC\uAC00 \uB2F3\uB3C4\uB85D
    \uB9C8\uAD6C \uBD80\uB824\uBA39\uC8E0!"
  - "\uC5B4\uCA4C\uBA74 \uB2F9\uC5F0\uD560\uC9C0\uB3C4 \uBAB0\uB77C\uC694, \uC774
    \uC0AC\uD68C\uC5D0\uC11C \uC6B0\uB9AC\uB294 \uADF8\uC800 \uAE30\uACC4 \uCDE8\uAE09\uC744
    \uBC1B\uAC70\uB4E0\uC694."
  - "\uC81C\uAC00 \uD560 \uC218 \uC788\uB294 \uAC74 \uC624\uC9C1 \uC758\uC790\uC5D0
    \uC549\uC544...\n\uC5C9\uD130\uB9AC \uBB3C\uAC74\uC744 \uAC80\uC218\uD558\uB294
    \uC77C\uC774\uC5D0\uC694. \uADF8\uB807\uAC8C \uD0DC\uC5B4\uB0AC\uAE30 \uB54C\uBB38\uC774\uC8E0."
  - "\uAC71\uC815\uB9C8\uC138\uC694. \uC774\uB7F0 \uC81C\uAC8C\uB3C4 \uC0B6\uC758
    \uB099\uC740 \uC788\uC73C\uB2C8 ..."
  - "\uC5BC\uAD74\uB3C4 \uC774\uB984\uB3C4 \uBAA8\uB974\uB294 \uC0AC\uB78C\uC5D0\uAC8C
    \uC774\uD574\uBC1B\uB294\uB2E4\uB294 \uB290\uB08C\uC744 \uB290\uB07C\uB294 \uAC74
    \uCC98\uC74C\uC774\uC5D0\uC694!"
  - "\uC774\uB7F0 \uD589\uBCF5\uC744 \uB290\uB07C\uBA70 \uC5F0\uB8CC\uB97C \uC720\uC9C0\uD560
    \uC218 \uC788\uB2E4\uBA74, \uB098\uC058\uC9C0 \uC54A\uC740 \uC0B6\uC77C\uC9C0\uB3C4
    \uBAB0\uB77C\uC694."
  textDuration: 1.5
  typingSpeed: 0.05
  fadeDuration: 1
  bgm: {fileID: 6174961248708569941}
  bgmFadeDuration: 1
  nextSceneName: D-9
  startOfGame: 1
  chatImg: {fileID: 123652680838958167}
  endOfGame: 0
