  m_text: "\uC5C5\uBB34 \uC911 \uC0AC\uC6A9 \uAC00\uB2A5\uD55C \uAE30\uB2A5\uC740
    \uD654\uBA74\uC758 \uBC84\uD2BC\uC744 \uC9C1\uC811 \uD074\uB9AD\uD558\uAC70\uB098\n\uB300\uC751\uD558\uB294
    \uB2E8\uCD95\uD0A4\uB97C \uB20C\uB7EC \uC2E4\uD589\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uAC01
    \uBC84\uD2BC\uC5D0 \uD45C\uC2DC\uB41C \uD0A4\uB97C \uD655\uC778\uD558\uC138\uC694.\n\uAC80\uC218
    \uACB0\uACFC\uB294 \uBC84\uD2BC\uC744 \uD074\uB9AD\uD558\uAC70\uB098 \uB300\uC751\uD558\uB294
    \uC22B\uC790 \uD0A4\uB97C \uB20C\uB7EC \uC120\uD0DD\uD569\uB2C8\uB2E4.\n\n\uAC80\uC218
    \uC911\uC778 \uC81C\uD488\uC740 \uB9C8\uC6B0\uC2A4 \uB610\uB294 \uBC29\uD5A5\uD0A4\uB85C
    \uD68C\uC804\uC2DC\uD0AC \uC218 \uC788\uC73C\uBA70,\n\uB9C8\uC6B0\uC2A4 \uD720\uC744
    \uC774\uC6A9\uD574 \uD655\uB300\uD558\uAC70\uB098 \uCD95\uC18C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.\n\n\uB9C8\uC6B0\uC2A4\uC640
    \uD0A4\uBCF4\uB4DC \uC911 \uD3B8\uD55C \uC870\uC791 \uBC29\uC2DD\uC744 \uC0AC\uC6A9\uD558\uC138\uC694."
  m_isRightToLeft: 0
