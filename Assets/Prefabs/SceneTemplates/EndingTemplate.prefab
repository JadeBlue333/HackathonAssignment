  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 386db9909b7e3164c8f6dbf9d2e8bf2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroManager
  blackImage: {fileID: 8756059483159492604}
  introText: {fileID: 3017264418142290507}
  introTexts:
  - "\uBA70\uCE60 \uB4A4 . . ."
  - "\uC0B0\uC5C5\uACC4\uC5D0 \uC0C8\uB85C\uC6B4 \uBC14\uB78C\uC774 \uBD88\uACE0
    \uC788\uC2B5\uB2C8\uB2E4."
  - "\uCD5C\uADFC \uC0DD\uC0B0 \uD6A8\uC728 \uD5A5\uC0C1\uC5D0 \uD06C\uAC8C \uAE30\uC5EC\uD55C
    \uD55C \uB85C\uBD07 \uAC1C\uCCB4\uAC00 \uD604\uC7A5 \uAD00\uB9AC \uAC10\uB3C5\uAD00\uC73C\uB85C
    \uC2B9\uC9C4\uD588\uB2E4\uB294\n\uB180\uB77C\uC6B4 \uC18C\uC2DD\uC774 \uC804\uD574\uC84C\uC2B5\uB2C8\uB2E4."
  - "\uB85C\uBD07\uC758 \uC791\uC5C5 \uC0C1\uD0DC\uC640 \uC0DD\uC0B0\uB7C9\uC744
    \uBA74\uBC00\uD788 \uD30C\uC545\uD574\uC628 \uACBD\uD5D8\uC744 \uBC14\uD0D5\uC73C\uB85C,\n\uC55E\uC73C\uB85C\uB294
    \uD604\uC7A5 \uADFC\uB85C\uC790\uB4E4\uC758 \uC5C5\uBB34\uB97C \uAD00\uB9AC\uD558\uACE0
    \uAC10\uB3C5\uD558\uB294 \uC5ED\uD560\uC744 \uB9E1\uAC8C \uB41C\uB2E4\uACE0 \uD558\uB294\uB370\uC694."
  - "\uB85C\uBD07\uC774 \uACFC\uAC70 \uD568\uAED8 \uC77C\uD558\uB358 \uB3D9\uB8CC\uB4E4\uC744
    \uC774\uC81C\uB294 \uAD00\uB9AC\uD558\uACE0 \uAC10\uB3C5\uD558\uB294 \uC9C1\uBB34\uB85C
    \uC2B9\uC9C4\uD55C \uCCAB \uC0AC\uB840\uB85C \uB0A8\uAC8C \uB41C \uAC83\uC785\uB2C8\uB2E4. "
  - "\uC77C\uBD80 \uD559\uACC4\uC5D0\uC11C\uB294 \uC774\uAC83\uC774 \uB85C\uBD07\uC758
    \uC0AC\uD68C\uC801 \uC9C0\uC704 \uD5A5\uC0C1\uC73C\uB85C,\n\uCD5C\uADFC \uC8FC\uBAA9\uBC1B\uB294
    '\uB85C\uBD07\uAD8C'\uC5D0 \uD070 \uAE0D\uC815\uC801\uC778 \uC601\uD5A5\uC744
    \uBBF8\uCE60 \uAC83\uC73C\uB85C \uC608\uC0C1\uD558\uACE0 \uC788\uC73C\uBA70 ..."
  - "<Ending 1/4 \u2014 \uCCAB \uBC88\uC9F8 \uC5D4\uB529: \uBC30\uC2E0>"
  textDuration: 1.5
  typingSpeed: 0.05
