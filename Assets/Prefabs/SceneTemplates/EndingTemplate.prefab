  m_Script: {fileID: 11500000, guid: 386db9909b7e3164c8f6dbf9d2e8bf2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroManager
  blackImage: {fileID: 8756059483159492604}
  introText: {fileID: 830981403582941026}
  introTexts:
  - A few days later...
  - A new wind is sweeping across the industry.
  - A robot credited with boosting production efficiency has been promoted to an
    on-site supervisor.
  - 'With experience monitoring robot performance and output,

    the robot will
    now oversee and manage workers on the factory floor.'
  - It marks the first time a robot has been promoted to manage and supervise its
    former coworkers.
  - "Some experts see this as a step forward for robots\u2019 social status,\nwith
    potentially positive implications for the increasingly discussed concept of \u201Crobot
    rights\u201D..."
  - "<Ending 1/4 \u2014 First Ending: Betrayal>"
  textDuration: 1.5
  typingSpeed: 0.03
  fadeDuration: 1
  bgm: {fileID: 7600165420317007852}
  bgmFadeDuration: 1
  nextSceneName: Progress
  startOfGame: 0
  chatImg: {fileID: 0}
  endOfGame: 1
