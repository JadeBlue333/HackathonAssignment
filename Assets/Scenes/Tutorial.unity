  m_text: "\uD558\uC790 \uAC80\uC218 \uB85C\uBD07\uC73C\uB85C\uC11C \uC624\uB298\uC758
    \uC5C5\uBB34\uB97C \uC2DC\uC791\uD569\uB2C8\uB2E4.\n\uB9C8\uC6B0\uC2A4 \uB610\uB294
