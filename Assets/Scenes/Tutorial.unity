  m_text: "\uAC80\uC218\uB97C 3\uD68C \uC5F0\uC18D \uC131\uACF5\uD558\uBA74 \uC2E0\uB8B0\uB3C4\uAC00
    1 \uC0C1\uC2B9\uD569\uB2C8\uB2E4.\n\uC774\uD6C4 \uC5F0\uC18D \uC131\uACF5\uC744
    \uC720\uC9C0\uD558\uB294 \uB3D9\uC548 \uC131\uACF5\uD560 \uB54C\uB9C8\uB2E4 1\uC529
