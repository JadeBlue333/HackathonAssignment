  m_Script: {fileID: 11500000, guid: 386db9909b7e3164c8f6dbf9d2e8bf2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroManager
  blackImage: {fileID: 1462925982}
  introText: {fileID: 1082050657}
  introTexts:
  - "\uCD95\uD558\uD560 \uB9CC\uD55C \uC18C\uC2DD\uC774\uAD70\uC694 - \uD50C\uB8E8\uD1A0\uC2A4\uACF5\uC5C5\uC774
    \uC62C\uD574 \uC0DD\uC0B0 \uBAA9\uD45C\uB97C \uC131\uACF5\uC801\uC73C\uB85C \uB2EC\uC131\uD588\uC2B5\uB2C8\uB2E4."
  - "\uD68C\uC0AC \uCE21\uC740 \uC774\uBC88 \uC131\uACFC\uC758 \uC8FC\uC694 \uC694\uC778\uC73C\uB85C,
    \uC778\uAC04 \uC911\uC2EC\uC758 \uC870\uC9C1 \uBB38\uD654\uC640 \uD6A8\uC728\uC801\uC778
    \uC0DD\uC0B0 \uAD00\uB9AC\uB97C \uAF3D\uC558\uC2B5\uB2C8\uB2E4."
  - "\uD55C \uD68C\uC0AC \uAD00\uACC4\uC790\uB294, \u2018\uC774\uB7EC\uD55C \uC131\uACFC\uB294
    \uAD6C\uC131\uC6D0\uB4E4\uC744 \uC704\uD574 \uB178\uB825\uD558\uB294 \uCD1D\uCC45\uC784\uC790
    \uB355\uBD84\u2019\uC774\uB77C\uBA70 \uAC10\uC0AC\uB97C \uC804\uD558\uAE30\uB3C4
    \uD588\uB294\uB370\uC694."
  - "\uD50C\uB8E8\uD1A0\uC2A4\uACF5\uC5C5\uC740 \uC55E\uC73C\uB85C\uB3C4 \uC9C0\uC18D\uC801\uC778
    \uAE30\uC220 \uD601\uC2E0\uC744 \uD1B5\uD574 \uC0DD\uC0B0\uC131\uC744 \uB192\uC5EC\uB098\uAC08
    \uACC4\uD68D\uC784\uC744 \uBC1D\uD614\uC2B5\uB2C8\uB2E4. ..."
  - "<Ending 2/4 \uB450 \uBC88\uC9F8 \uC5D4\uB529: \uB9DD\uAC01>"
  textDuration: 1.5
  typingSpeed: 0.05
  fadeDuration: 1
  bgm: {fileID: 1042138439}
  bgmFadeDuration: 1
  nextSceneName: MainMenu
