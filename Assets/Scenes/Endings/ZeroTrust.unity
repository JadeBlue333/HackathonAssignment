  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CeoDialogue2
  dialogueText: {fileID: 1674448248}
  lines:
  - "\uB108 \uC7A5\uB09C\uCCD0?! \uB0A8\uC758 \uC0AC\uC5C5\uC7A5\uC5D0\uC11C \uC774\uAC8C
    \uBB50\uD558\uB294 \uC9D3\uC774\uC57C?"
  - "\uC2E4\uC218\uB97C \uBD10\uC8FC\uB294 \uAC83\uB3C4 \uD55C \uB450 \uBC88\uC774\uC9C0.
    \uC815\uD655\uD788 \uD558\uB294 \uC77C\uC774 \uC5C6\uC5B4!"
  - "\uB108 \uAC19\uC740 \uB85C\uBD07\uC740 \uD3D0\uAE30\uCC98\uB9AC\uD558\uB294
    \uAC8C \uC6B0\uB9AC \uD68C\uC0AC\uC5D0 \uB354 \uB3C4\uC6C0\uC774 \uB41C\uB2E4\uACE0!"
  - "\uC560\uCD08\uC5D0 \uC774 \uBAA8\uB378\uC744 \uC0AC\uB4E4\uC774\uB294 \uAC8C
    \uC544\uB2C8\uC5C8\uB294\uB370."
  - "\uC369 \uAEBC\uC838!"
  gameOverPanel: {fileID: 1078446532}
