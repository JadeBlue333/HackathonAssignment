--- !u!114 &1179311591
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1179311590}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8ffd1a4c39a4c7742a34ebc5b6204daf, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::CeoDialogue
  dialogueText: {fileID: 1674448248}
  lines:
  - "\uAC11\uC790\uAE30 \uCC3E\uC544\uC640\uC11C \uB180\uB790\uACA0\uAD70. \uC544\uB2C8\uC9C0,
    \uB85C\uBD07\uC5D0\uAC90 \uB180\uB780\uB2E4\uB294 \uAC10\uC815\uC774 \uC5C6\uC73C\uB824\uB098?"
  - "\uB0B4 \uC2DC\uAC04\uC740 \uBE44\uC2F8\uB2C8 \uAC70\uB450\uC808\uBBF8\uD558\uC9C0.
    \uB124 \uC791\uC5C5 \uC2E0\uB8B0\uB3C4 \uB370\uC774\uD130\uAC00 \uB192\uB2E4\uB294
    \uBCF4\uACE0\uB97C \uBC1B\uC558\uB2E4."
  - "\uB10C \uB2E4\uB978 \uB85C\uBD07\uB4E4\uC5D0 \uBE44\uD574, \uBB50\uB784\uAE4C.
    \uD2B9\uBCC4\uD558\uB2E4\uACE0 \uD574\uB450\uC9C0."
  - "\uC774\uC0C1\uD55C \uC18C\uBB38\uC774 \uB3CC\uB354\uAD70. \uC778\uAC04\uC774
    \uB420 \uC218 \uC788\uB2E4\uB098 \uBB50\uB77C\uB098."
  - "\uADF8\uB7F0 \uC18C\uBB38\uC744 \uBBFF\uB2E4\uB2C8, \uB85C\uBD07\uC778 \uB124\uAC00
    \uC0DD\uAC01\uD574\uB3C4 \uB2E4\uB978 \uB85C\uBD07\uB4E4\uC774 \uB108\uBB34 \uBA4D\uCCAD\uD558\uC9C0
    \uC54A\uC740\uAC00?"
  - "\uADF8\uB7EC\uB2C8 \uB124\uAC8C \uC0C8\uB85C\uC6B4 \uC9C1\uCC45\uC744 \uC8FC\uC9C0."
  - "\uBCC4 \uAC74 \uC544\uB2C8\uACE0, \uB2E4\uB978 \uB85C\uBD07\uB4E4\uC744 \uAC10\uC2DC\uD558\uB294
    \uAC70\uC57C. \uAC70\uB3D9\uC774 \uC218\uC0C1\uD55C \uB85C\uBD07\uC740 \uAC16\uB2E4
    \uBC84\uB824."
  - "\uC9C0\uAE08\uBCF4\uB2E4 \uB192\uC740 \uBD09\uAE09\uACFC \uD3B8\uC548\uD55C
    \uC77C\uC790\uB9AC\uC77C\uAC70\uC57C. \uC5B4\uB54C? \uC194\uAE43\uD558\uC9C0?"
  choicePanel: {fileID: 1078446532}
  choiceButton1: {fileID: 2006355397}
  choiceButton2: {fileID: 652404618}
  choice1Text: "\uC218\uB77D\uD55C\uB2E4"
  choice2Text: "\uAC70\uC808\uD55C\uB2E4"
  lastDialogue1: "\uD6C4\uD68C\uD558\uC9C0 \uC54A\uC744 \uAC78\uC138. \uC790\uB124\uB294
    \uC5ED\uC2DC \uB611\uB611\uD55C \uB85C\uBD07\uC774\uAD70."
  lastDialogue2: "\uBB50? \uADF8\uB807\uB2E4\uBA74 \uC5B4\uCA54 \uC218 \uC5C6\uC9C0.
    \uBA4D\uCCAD\uD558\uAE30\uB294."
  goToThisScene: {fileID: 285070609}
  typingSpeed: 0.04
