  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 386db9909b7e3164c8f6dbf9d2e8bf2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroManager
  blackImage: {fileID: 1057428021}
  introText: {fileID: 1082050657}
  introTexts:
  - "...\uC774\uC5B4\uC11C \uC0B0\uC5C5\uACC4 \uC8FC\uC694 \uB3D9\uD5A5\uC5D0 \uAD00\uD55C
    \uC18C\uC2DD \uC804\uD574\uB4DC\uB9AC\uACA0\uC2B5\uB2C8\uB2E4."
  - "\uC0B0\uC5C5\uACC4\uC5D0 \uC0C8\uB85C\uC6B4 \uBC14\uB78C\uC774 \uBD88\uACE0
    \uC788\uC2B5\uB2C8\uB2E4."
  - "\uD50C\uB8E8\uD1A0\uC2A4\uACF5\uC5C5 \uC8FC\uC2DD\uD68C\uC0AC\uAC00 \uD558\uC790
    \uAC80\uC218\uC6A9 \uBAA8\uB378, AT0805 \uB85C\uBD07\uC744 \uB300\uB7C9 \uB9E4\uC785\uD558\uBA70\n\uD604\uC7A5
    \uC790\uB3D9\uD654\uC5D0 \uC18D\uB3C4\uB97C \uB0B4\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uB300\uADDC\uBAA8 \uB85C\uBD07 \uB3C4\uC785\uC744 \uAE30\uBC18\uC73C\uB85C
    \uD488\uC9C8 \uAC80\uC218 \uD6A8\uC728\uC744 \uB192\uC774\uACE0 \uC0DD\uC0B0\uC131\uC744
    \uB04C\uC5B4\uC62C\uB9AC\uBA74\uC11C,\n\uCD5C\uADFC \uC2E4\uC801 \uC5ED\uC2DC
    \uAC00\uD30C\uB978 \uC0C1\uC2B9\uC138\uB97C \uBCF4\uC774\uACE0 \uC788\uB294\uB370\uC694."
  - "\uC774 \uAC19\uC740 \uC131\uC7A5\uC138\uC5D0 \uD798\uC785\uC5B4 \uD50C\uB8E8\uD1A0\uC2A4\uACF5\uC5C5\uC758
    \uC8FC\uAC00 \uC5ED\uC2DC \uC5F0\uC77C \uC0C1\uC2B9\uC138\uB97C \uC774\uC5B4\uAC00\uBA70,\n\uC2DC\uC7A5\uC758
    \uB728\uAC70\uC6B4 \uAD00\uC2EC\uC744 \uBC1B\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
  - "\uC804\uBB38\uAC00\uB4E4\uC740 \uC778\uAC74\uBE44 \uC808\uAC10\uBFD0\uB9CC \uC544\uB2C8\uB77C,
    \uAE30\uC874 \uC778\uB825 \uC6B4\uC601\uC5D0\uC11C \uBC1C\uC0DD\uD558\uB358\n\uB178\uC0AC
    \uAD00\uB828 \uB9AC\uC2A4\uD06C\uB97C \uCD5C\uC18C\uD654\uD560 \uC218 \uC788\uB2E4\uB294
    \uC810\uB3C4 \uB85C\uBD07 \uB3C4\uC785\uC758 \uC8FC\uC694 \uC7A5\uC810\uC73C\uB85C
    \uAF3D\uC558\uC2B5\uB2C8\uB2E4."
  - "\uC5C5\uACC4\uC5D0\uC11C\uB294 \uC774\uBC88 \uB85C\uBD07 \uB3C4\uC785\uC774
    \uD50C\uB8E8\uD1A0\uC2A4\uACF5\uC5C5\uC758 \uC0C8\uB85C\uC6B4 \uC131\uC7A5 \uB3D9\uB825\uC774
    \uB420 \uAC83\uC774\uB77C\uB294 \uAE30\uB300\uAC10\uC774 \uCEE4\uC9C0\uACE0 \uC788\uC73C\uBA70
    ..."
  textDuration: 1.5
  typingSpeed: 0.05
  fadeDuration: 1
  bgm: {fileID: 1042138439}
  bgmFadeDuration: 1
  nextSceneName: Progress
