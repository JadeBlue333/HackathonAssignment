  m_Script: {fileID: 11500000, guid: 386db9909b7e3164c8f6dbf9d2e8bf2a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::IntroManager
  blackImage: {fileID: 1057428021}
  introText: {fileID: 462493982}
  introTexts:
  - ...And now, a look at the latest developments across the industry.
  - A new wind is sweeping across the industry.
  - 'Plutos Industries Co., Ltd. is accelerating on-site automation with

    a large-scale
    purchase of its AT0805 defect inspection robots.'
  - "With the large-scale adoption of robotics boosting inspection efficiency and
    productivity,\nthe company\u2019s recent performance has also been on a steep
    upward trajectory."
  - "Buoyed by this strong growth, Plutos Industries\u2019 stock has continued to
    climb,\ndrawing keen interest from the market."
  - 'Experts point to not only reduced labor costs, but also the ability to minimize
    labor-related risks

    associated with managing a human workforce as a key
    advantage of adopting robots.'
  - 'Industry experts are increasingly optimistic that this latest robot rollout

    could
    become a new engine for growth at Plutos Industries...'
  textDuration: 1.5
  typingSpeed: 0.03
  fadeDuration: 1
  bgm: {fileID: 1042138439}
  bgmFadeDuration: 1
  nextSceneName: Progress
  startOfGame: 0
  chatImg: {fileID: 0}
  endOfGame: 0
