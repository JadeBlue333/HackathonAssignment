    - target: {fileID: 5166763506543117150, guid: 8ae6ad3614f9d284690b7ccab06fdd24, type: 3}
      propertyPath: m_text
      value: 'Fuel keeps you operational.

        10 fuel is provided at the start
        of each day,

        and 2 fuel is consumed for every product inspected.


        Manage
        your fuel carefully.

        If your fuel reaches 0, you will be discarded.'
      objectReference: {fileID: 0}
