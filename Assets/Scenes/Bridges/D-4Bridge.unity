    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: chatImg
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: startOfGame
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: nextSceneName
      value: D-4
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: introTexts.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[0]'
      value: Do you remember?
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[1]'
      value: You know, that strange merchant we met before.
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[2]'
      value: It's been quiet for days now, so it must have just been a malfunction.
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[3]'
      value: In the vast world of robots, nothing is truly impossible.
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[4]'
      value: 'They say robots these days are so overworked that they rarely power
        down and rest,

        leading to a sharp rise in malfunctions.'
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[5]'
      value: 'Working hard isn''t necessarily a bad thing.

        If I save up
        enough, maybe it''ll open the door to something more.'
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[6]'
      value: ...If only you, Valerie, would trust what I feel and wait for me.
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[7]'
      value: 'For the first time, I feel like someone who doesn''t even know

        my
        face or name truly understands me!'
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[8]'
      value: If I can keep my fuel running and still feel this kind of happiness,
        maybe this isn't such a bad life after all.
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: startOfGame
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: nextSceneName
      value: D-4
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: introTexts.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[0]'
      value: "\uAE30\uC5B5\uB098\uC138\uC694?"
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[1]'
      value: "\uADF8\uB54C \uADF8 \uC774\uC0C1\uD55C \uC0C1\uC778 \uB9D0\uC774\uC5D0\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[2]'
      value: "\uBA70\uCE60 \uC9F8 \uC7A0\uC7A0\uD558\uB2C8, \uBD84\uBA85 \uC81C \uC624\uC791\uB3D9\uC774\uACA0\uC8E0."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[3]'
      value: "\uB113\uB514\uB113\uC740 \uB85C\uBD07\uC758 \uC138\uACC4\uC5D0\uC120
        \uBD88\uAC00\uB2A5\uD55C \uC77C\uB3C4 \uC544\uB2C8\uC5D0\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[4]'
      value: "\uC694\uC998 \uB85C\uBD07\uB4E4\uC740 \uB108\uBB34\uB098 \uBC14\uBE60\uC11C,
        \uC790\uC8FC \uC804\uC6D0\uC744 \uB044\uACE0 \uC26C\uC5B4\uC8FC\uC9C0 \uC54A\uC544
        \uC624\uC791\uB3D9\uD558\uB294 \uBE44\uC728\uC774 \uD06C\uAC8C \uB298\uC5C8\uB300\uC694. "
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[5]'
      value: "\uC5F4\uC2EC\uD788 \uC77C\uD558\uB294 \uAC8C \uB098\uC058\uC9C0\uB9CC\uC740
        \uC54A\uC544\uC694. \uB3C8\uC744 \uB9CE\uC774 \uBAA8\uC73C\uBA74, \uBB54\uAC00\uC758
        \uAE30\uD68C\uAC00 \uC0DD\uAE38\uC9C0\uB3C4 \uBAA8\uB974\uC8E0."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[6]'
      value: "... \uC624\uC9C1 \uBC1C\uB808\uB9AC \uB2F9\uC2E0\uC774, \uB098\uC758
        \uB9C8\uC74C\uC744 \uBBFF\uACE0 \uAE30\uB2E4\uB824 \uC900\uB2E4\uBA74."
      objectReference: {fileID: 0}
    - target: {fileID: 6289247631775507956, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: m_Name
      value: BridgeTemplate
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects:
    - {fileID: 123652680838958167, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
