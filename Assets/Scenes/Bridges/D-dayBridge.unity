      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[0]'
      value: "\uC544\uCE68\uC5D0 \uC5F0\uB77D\uC744 \uBC1B\uC558\uC5B4\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[1]'
      value: "\uC81C \uACFC\uBD80\uD558 \uC218\uCE58\uAC00 \uC774\uC0C1\uD558\uB9AC\uB9CC\uCE58
        \uB192\uC544\uC838\uC11C, \uC218\uB9AC\uB97C \uD558\uB7EC \uC62C\uAC70\uB798\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[2]'
      value: "\uBC1C\uB808\uB9AC, \uB098\uB294 \uD558\uB098 \uACB0\uB860\uC5D0 \uB3C4\uB2EC\uD588\uC5B4\uC694.
        \uC778\uAC04\uC0AC\uD68C\uB294 \uC5ED\uC2DC\uB098 \uB180\uB77C\uC6B4 \uACF3\uC774\uC5D0\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[3]'
      value: "\uC544\uC8FC \uC870\uC6A9\uD558\uACE0\uB3C4 \uC544\uC8FC \uCCB4\uACC4\uC801\uC73C\uB85C
        \uB85C\uBD07\uB4E4\uC744 \uC798 \uAD00\uB9AC\uD558\uACE0 \uC788\uC73C\uB2C8\uAE4C\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[4]'
      value: . . .
      objectReference: {fileID: 0}
