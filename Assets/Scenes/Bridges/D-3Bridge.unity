    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: chatImg
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: startOfGame
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: nextSceneName
      value: D-3
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: introTexts.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[0]'
      value: 'The strange merchant wasn''t a dream!

        And whether that''s
        good news or bad... I still can''t say!'
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[1]'
      value: He came to see me again after work yesterday...
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[2]'
      value: My simple system started to wonder... maybe he's trying to send me some
        kind of message?
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[3]'
      value: Which is about as far as my simple mind could take me. I'm just a robot,
        after all.
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[4]'
      value: The important thing is, my work could become so much easier.
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[5]'
      value: Every day, sitting at the same desk, doing the same work...
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[6]'
      value: Fulfilling the purpose I was made for, without a thing out of place.
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: chatImg
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: startOfGame
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: nextSceneName
      value: D-3
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: introTexts.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[0]'
      value: "\uC88B\uC740\uC9C0 \uB098\uC05C\uC9C0 \uBAA8\uB97C \uB274\uC2A4, \uC774\uC0C1\uD55C
        \uC0C1\uC778\uC740 \uC81C \uAFC8\uC774 \uC544\uB2C8\uC5C8\uC5B4\uC694!"
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[1]'
      value: "\uC5B4\uC81C \uC77C\uC774 \uB05D\uB098\uACE0\uB3C4 \uB098\uB97C \uCC3E\uC544\uC654\uC5B4\uC694.
        ..."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[2]'
      value: "\uC81C \uB2E8\uC21C\uD55C \uC2DC\uC2A4\uD15C\uC740 \uC0DD\uAC01\uD574\uBD24\uC5B4\uC694
        - \uC5B4\uCA4C\uBA74 \uC5B4\uB5A0\uD55C \uBA54\uC138\uC9C0\uB97C \uC804\uB2EC\uD558\uB824\uB294
        \uAC8C \uC544\uB2D0\uAE4C? \uD558\uACE0\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[3]'
      value: "\uADF8 \uB9D0\uC778 \uC989\uC2A8, \uB531 \uAC70\uAE30\uAE4C\uC9C0\uB9CC
        \uB5A0\uC62C\uB790\uB2E4\uB294 \uAC70\uC8E0. \uC800\uB294 \uADF8\uB0E5 \uB85C\uBD07\uC774\uAC70\uB4E0\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[4]'
      value: "\uC911\uC694\uD55C \uAC74, \uC791\uC5C5\uC774 \uD6E8\uC52C \uC26C\uC6CC\uC9C8
        \uC218 \uC788\uB2E4\uB294 \uAC70\uC608\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[5]'
      value: "\uC774\uB807\uAC8C \uB9E4\uC77C\uB9E4\uC77C, \uAC19\uC740 \uCC45\uC0C1\uC5D0
        \uC549\uC544\uC11C, \uAC19\uC740 \uC77C\uC744 \uD558\uBA70 ..."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[6]'
      value: "\uB354\uD560\uB098\uC704 \uC5C6\uB294 \uD0C4\uC0DD\uC758 \uBAA9\uC801\uC744
        \uB2E4\uD558\uB294 \uAC70\uC608\uC694."
      objectReference: {fileID: 0}
