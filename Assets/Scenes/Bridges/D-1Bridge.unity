    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: chatImg
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: startOfGame
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: nextSceneName
      value: D-1
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: introTexts.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[0]'
      value: I didn't power down last night. I spent the whole night thinking about
        it... really thinking.
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[1]'
      value: About what I could do if I wasn't doing this job.
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[2]'
      value: 'Models like me, the AT0805, inspect factory goods.

        Some models
        take care of children, while others clean the streets.'
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[3]'
      value: The more complex the work, the more expensive the robot.
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[4]'
      value: I started to wonder... could there really be a model with no purpose
        at all?
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[5]'
      value: 'If such a robot did exist, would it be sold for next to nothing?

        Maybe
        even for zero Kreta.'
      objectReference: {fileID: 0}
    - target: {fileID: 3298234864207022646, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[6]'
      value: ...I left myself powered on all night, so I must be tired today.
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: chatImg
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: startOfGame
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: nextSceneName
      value: D-1
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: introTexts.Array.size
      value: 7
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[0]'
      value: "\uC2E4\uC740 \uBC24 \uC0AC\uC774 \uC804\uC6D0\uC744 \uB044\uC9C0 \uC54A\uACE0,
        \uC628\uC885\uC77C \uACE0\uBBFC\uD588\uC5B4\uC694. \uC544\uC8FC \uC5F4\uC2EC\uD788\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[1]'
      value: "\uC774 \uC77C\uC774 \uC544\uB2C8\uB77C\uBA74, \uC81C\uAC00 \uBB34\uC5C7\uC744
        \uD560 \uC218 \uC788\uB294\uC9C0\uC5D0 \uB300\uD574 \uB9D0\uC774\uC5D0\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[2]'
      value: "\uB098\uC640 \uAC19\uC740 \uBAA8\uB378 AT0805\uB294 \uACF5\uC7A5 \uBB3C\uD488\uC744
        \uAC80\uC218\uD558\uACE0,\n\uC5B4\uB5A4 \uBAA8\uB378\uC740 \uC544\uC774\uB97C
        \uB3CC\uBCF4\uACE0, \uB610 \uB2E4\uB978 \uC5B4\uB5A4 \uBAA8\uB378\uC740 \uAE38\uAC70\uB9AC\uB97C
        \uCCAD\uC18C\uD558\uC8E0. "
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[3]'
      value: "\uB354 \uC5B4\uB824\uC6B4 \uC77C\uC744 \uD560\uC218\uB85D \uB85C\uBD07\uC758
        \uAC00\uACA9\uC740 \uBE44\uC2F8\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[4]'
      value: "\uAD81\uAE08\uD574\uC84C\uC5B4\uC694, \uC544\uBB34\uB7F0 \uBAA9\uC801\uB3C4
        \uC5C6\uB294 \uBAA8\uB378\uC740 \uC874\uC7AC\uD558\uC9C0 \uC54A\uB294 \uAC78\uAE4C\uC694?"
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[5]'
      value: "\uB9CC\uC57D \uADF8\uB7F0 \uB85C\uBD07\uC774 \uC874\uC7AC\uD55C\uB2E4\uBA74\uC694,\n\uADF8
        \uB85C\uBD07\uC740 \uC544\uC8FC \uD5D0\uAC12\uC5D0 \uD314\uB9B4\uAE4C\uC694?
        \uC5B4\uCA4C\uBA74 0 \uD06C\uB808\uD0C0\uC77C\uC9C0\uB3C4 \uBAA8\uB974\uC8E0."
      objectReference: {fileID: 0}
    - target: {fileID: 4521109688250147309, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: 'introTexts.Array.data[6]'
      value: "... \uBC24\uC0C8 \uC804\uC6D0\uC744 \uCF1C\uB450\uC5C8\uC73C\uB2C8
        \uC624\uB298\uC740 \uD53C\uACE4\uD558\uACA0\uC5B4\uC694."
      objectReference: {fileID: 0}
    - target: {fileID: 6289247631775507956, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
      propertyPath: m_Name
      value: BridgeTemplate
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects:
    - {fileID: 7515301378082972448, guid: bc3cfb429ef802c41b964ff4fb62c661, type: 3}
